# Local task continuity; never commit task context.
# Layout: .agent-state/<project>/project/ (stable memory) and .agent-state/<project>/tasks/<task>/ (checkpoint, handoffs, receipts, inputs/).
.agent-state/
# Local runtime settings and credentials must stay outside the public repository.
.claude/settings.local.json
.mcp.local.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
Task #*.pdf
# Legacy: task inputs now live in .agent-state/<project>/tasks/<task>/inputs/.
tmp/pdfs/*
# Local Python environments, caches and diagnostic output.
.venv/
.pytest_cache/
.coverage
*.log
# Python bytecode caches regenerated by running scripts/ or the tests/ suite.
__pycache__/
*.pyc
